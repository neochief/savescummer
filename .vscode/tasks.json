{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SaveScummer: build dev",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/vscode-session.ps1", "-Action", "demo"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SaveScummer: test Rust and Qt",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/build.ps1", "dev", "-Test"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SaveScummer: prepare app",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/vscode-session.ps1", "-Action", "prepare"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SaveScummer: stop debug host",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/vscode-session.ps1", "-Action", "stop"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "SaveScummer: package release",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/build.ps1", "release"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"]
        }
    ]
}
