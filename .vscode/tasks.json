{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SaveScummer: build dev",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "build", "--package"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc", "$msCompile"]
        },
        {
            "label": "SaveScummer: test",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "build", "--test"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc", "$msCompile"]
        },
        {
            "label": "SaveScummer: check",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "check"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "SaveScummer: start dev host",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "host", "start"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc", "$msCompile"]
        },
        {
            "label": "SaveScummer: start dev host (demo)",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "host", "start", "--demo"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc", "$msCompile"]
        },
        {
            "label": "SaveScummer: stop dev host",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "host", "stop"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "SaveScummer: dist",
            "type": "process",
            "command": "cargo",
            "args": ["xtask", "dist"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc", "$msCompile"]
        }
    ]
}
