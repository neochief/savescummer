{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SaveScummer: UI",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/package/SaveScummer-windows-x64/bin/SaveScummer.UI.exe",
            "args": ["--data-dir", "${workspaceFolder}/.runtime/dev"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "SaveScummer: start dev host",
            "postDebugTask": "SaveScummer: stop dev host"
        },
        {
            "name": "SaveScummer: UI (demo)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/package/SaveScummer-windows-x64/bin/SaveScummer.UI.exe",
            "args": ["--data-dir", "${workspaceFolder}/.runtime/dev", "--demo"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "SaveScummer: start dev host (demo)",
            "postDebugTask": "SaveScummer: stop dev host"
        }
    ]
}
