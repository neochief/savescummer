{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SaveScummer: app",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/desktop/apps/desktop/RelWithDebInfo/SaveScummer.exe",
            "args": [
                "--data-dir", "${workspaceFolder}/.runtime/vscode",
                "--host", "${workspaceFolder}/target/debug/savescummer-host.exe"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "${workspaceFolder}/.runtime/Qt/6.5.3/msvc2019_64/bin;${env:PATH}" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "SaveScummer: prepare app",
            "postDebugTask": "SaveScummer: stop debug host"
        },
        {
            "name": "SaveScummer: demo",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/desktop/apps/desktop/RelWithDebInfo/SaveScummer.exe",
            "args": ["--demo"],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "${workspaceFolder}/.runtime/Qt/6.5.3/msvc2019_64/bin;${env:PATH}" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "SaveScummer: build dev"
        }
    ]
}
