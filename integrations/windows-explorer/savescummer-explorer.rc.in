#include <windows.h>

1 ICON "@SAVESCUMMER_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SAVESCUMMER_VERSION_MAJOR@,@SAVESCUMMER_VERSION_MINOR@,@SAVESCUMMER_VERSION_PATCH@,0
 PRODUCTVERSION @SAVESCUMMER_VERSION_MAJOR@,@SAVESCUMMER_VERSION_MINOR@,@SAVESCUMMER_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SaveScummer contributors\0"
            VALUE "FileDescription", "SaveScummer Explorer Integration\0"
            VALUE "FileVersion", "@SAVESCUMMER_VERSION@\0"
            VALUE "InternalName", "savescummer-explorer\0"
            VALUE "LegalCopyright", "SaveScummer contributors\0"
            VALUE "OriginalFilename", "savescummer-explorer.dll\0"
            VALUE "ProductName", "SaveScummer\0"
            VALUE "ProductVersion", "@SAVESCUMMER_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END