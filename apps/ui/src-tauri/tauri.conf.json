{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveScummer",
  "version": "0.2.0",
  "identifier": "com.savescummer.ui.trial",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "SaveScummer",
      "width": 800,
      "height": 680,
      "minWidth": 700,
      "maxWidth": 800,
      "minHeight": 480,
      "backgroundColor": "#1c1918",
      "theme": "Dark",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
